model Payment {
    id            String @id @default(uuid(7))
    appointmentId String @unique
    patientId     String
    doctorId      String
    amount        Float

    transactionId String?       @unique
    status        PaymentStatus @default(UNPAID)
    paymentDate   DateTime?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    // Relations
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([appointmentId], name: "idx_payment_appointmentId")
    @@index([patientId], name: "idx_payment_patientId")
    @@index([doctorId], name: "idx_payment_doctorId")
    @@index([status], name: "idx_payment_status")
    @@index([paymentDate], name: "idx_payment_paymentDate")
    @@map("payments")
}
