model Payment {
    id            String @id @default(uuid(7))
    appointmentId String @unique

    amount Float

    transactionId      String?       @unique @db.Uuid()
    stripeEventId      String?       @unique
    status             PaymentStatus @default(UNPAID)
    paymentGatewayData Json?
    paymentDate        DateTime?
    createdAt          DateTime      @default(now())
    updatedAt          DateTime      @updatedAt

    // Relations
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([appointmentId], name: "idx_payment_appointmentId")
    @@index([transactionId], name: "idx_payment_transactionId")
    @@index([status], name: "idx_payment_status")
    @@index([paymentDate], name: "idx_payment_paymentDate")
    @@map("payments")
}
