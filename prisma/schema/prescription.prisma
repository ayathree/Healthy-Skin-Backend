model Prescription {
    id            String    @id @default(uuid(7))
    appointmentId String    @unique
    doctorId      String
    patientId     String
    issueDate     DateTime  @default(now())
    diagnosis     String    @db.Text
    medicines     String?   @db.Text // Simple text field for medicines
    instructions  String?   @db.Text
    followUpDate  DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Relations
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([appointmentId], name: "idx_prescription_appointmentId")
    @@index([doctorId], name: "idx_prescription_doctorId")
    @@index([patientId], name: "idx_prescription_patientId")
    @@index([issueDate], name: "idx_prescription_issueDate")
    @@map("prescriptions")
}
