model Appointment {
    id        String @id @default(uuid(7))
    patientId String
    doctorId  String

    scheduleId     String
    videoCallingId String            @unique @db.Uuid()
    status         AppointmentStatus @default(SCHEDULED)
    paymentStatus  PaymentStatus     @default(UNPAID)
    createdAt      DateTime          @default(now())
    updatedAt      DateTime          @updatedAt

    // Relations
    patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    // One appointment can have one payment, review, prescription, and medical report
    payment       Payment?
    review        Review?
    prescription  Prescription?
    medicalReport MedicalReport?

    @@index([patientId], name: "idx_appointment_patientId")
    @@index([doctorId], name: "idx_appointment_doctorId")
    @@index([status], name: "idx_appointment_status")
    @@index([paymentStatus], name: "idx_appointment_paymentStatus")
    @@index([createdAt], name: "idx_appointment_createdAt")
    @@map("appointments")
}
