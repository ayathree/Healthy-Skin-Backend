model Schedule {
    id            String   @id @default(uuid(7))
    startDateTime DateTime
    endDateTime   DateTime
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    doctorSchedules DoctorSchedules[]
    appointment     Appointment[]

    @@index([startDateTime], name: "idx_schedule_startDate")
    @@index([endDateTime], name: "idx_schedule_endDate")
    @@map("schedules")
}

model DoctorSchedules {
    id         String   @id @default(uuid(7))
    doctorId   String
    scheduleId String
    isBooked   Boolean  @default(false)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relations
    doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@unique([doctorId, scheduleId], name: "unique_doctor_schedule")
    @@index([doctorId], name: "idx_doctor_schedules_doctorId")
    @@index([scheduleId], name: "idx_doctor_schedules_scheduleId")
    @@index([isBooked], name: "idx_doctor_schedules_isBooked")
    @@map("doctor_schedules")
}
