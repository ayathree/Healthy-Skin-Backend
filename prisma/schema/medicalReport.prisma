model MedicalReport {
    id            String    @id @default(uuid(7))
    patientId     String
    doctorId      String
    appointmentId String    @unique
    diagnosis     String
    treatment     String
    followUpDate  DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    // Relations
    patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([patientId], name: "idx_medical_report_patientId")
    @@index([doctorId], name: "idx_medical_report_doctorId")
    @@index([appointmentId], name: "idx_medical_report_appointmentId")
    @@index([followUpDate], name: "idx_medical_report_followUpDate")
    @@index([createdAt], name: "idx_medical_report_createdAt")
    @@map("medical_reports")
}
