model Review {
    id            String   @id @default(uuid(7))
    patientId     String
    doctorId      String
    appointmentId String   @unique
    rating        Float
    comment       String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    // Relations
    patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade, onUpdate: Cascade)

    @@index([patientId], name: "idx_review_patientId")
    @@index([doctorId], name: "idx_review_doctorId")
    @@index([appointmentId], name: "idx_review_appointmentId")
    @@index([rating], name: "idx_review_rating")
    @@index([createdAt], name: "idx_review_createdAt")
    @@map("reviews")
}
